# NovaE²E Production Configuration
PORT="8081"
APP_BASE="https://e2e.novaos.cloud"

APP_NAME="NovaE²E"
BRAND_NAME="NovaE²E"
OPEN_GRAPH_TITLE="NovaE²E — Quantum Encrypted Messaging"
OPEN_GRAPH_DESCRIPTION="The most secure end-to-end encrypted messaging platform. Quantum encryption, MLS protocol, self-hosted."

ENFORCE_HTTPS="true"

# Backend points to our Wire server
BACKEND_REST="https://e2e.novaos.cloud"
BACKEND_WS="wss://e2e.novaos.cloud"

# CSP
CSP_EXTRA_CONNECT_SRC="https://e2e.novaos.cloud, wss://e2e.novaos.cloud, https://novaos.cloud"
CSP_EXTRA_IMG_SRC="https://e2e.novaos.cloud, https://novaos.cloud"
CSP_EXTRA_SCRIPT_SRC="https://e2e.novaos.cloud, https://novaos.cloud"
